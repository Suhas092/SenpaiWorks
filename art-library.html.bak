        <div class="pinterest-item" data-category="others" data-charname="Neo-Tokyo Nightline"
          data-source="Cyberpunk 2099" data-sex="N/A" data-artstyle="Cyberpunk Panorama"
          data-description="An ultra-wide panoramic artwork showing the dazzling lights, holographic billboards, and towering skyscrapers of futuristic Neo-Tokyo at midnight.">
          <img src="assets/art-others-2.png" alt="Neo-Tokyo Nightline" />
