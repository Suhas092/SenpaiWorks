        <!-- OTHERS / HORIZONTAL ARTWORK -->
        <div class="pinterest-item" data-category="others" data-charname="Sakura Shrine Sunset"
          data-source="Original Concept" data-sex="N/A" data-artstyle="Landscape Digital"
          data-description="A serene widescreen landscape illustration depicting a traditional Japanese shrine enveloped in glowing cherry blossoms under a golden twilight sky.">
