<!DOCTYPE html>
<html lang="en">

<head>
  <link rel="icon" href="assets/Videos/SenpaiWorks logo.png" type="image/png">

  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>2D Art Library - SenpaiWorks</title>
  <link rel="stylesheet" href="home.css">
  <link rel="stylesheet" href="header.css">
  <link rel="stylesheet" href="art-library.css?v=37">
  <!-- FontAwesome for icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>

<body>

  <!-- Header -->
  <div id="header-placeholder">
    <script>
      (function () {
        var cached = sessionStorage.getItem('cached_header');
        if (cached) {
          document.getElementById('header-placeholder').innerHTML = cached;
        }
      })();
    </script>
  </div>
  <script src="scripts/header.js?v=6"></script>

  <div class="top-bg-strip"></div>

  <div id="drawer-container"></div>
  <script src="scripts/drawer.js?v=6"></script>

  <!-- Hero Banner Section -->
  <section class="tech-hero-section">
    <div class="tech-hero-bg" style="background-image: url('assets/Suzens band.png');">
    </div>
    <div class="tech-hero-overlay">
      <h1 class="tech-title">2D ART LIBRARY</h1>
      <p class="tech-description">Explore original anime portraits, insane artwork, and hand-crafted pencil drawings by
        SenpaiWorks.</p>
    </div>
  </section>

  <!-- Category Filter Bar -->
  <div class="category-filter-bar">
    <button class="filter-btn active" data-filter="all">All</button>
    <button class="filter-btn" data-filter="digital-portrait">Digital Portrait</button>
    <button class="filter-btn" data-filter="insane-artwork">Insane Artwork</button>
    <button class="filter-btn" data-filter="color-pencil">Color Pencil</button>
    <button class="filter-btn" data-filter="charcoal-pencil">Charcoal & Pencil</button>
    <button class="filter-btn" data-filter="others">Others</button>
  </div>

  <!-- Pinterest Page Layout -->
  <section class="pin-page-layout" id="pin-page-layout">
    <div class="pin-feed-col" id="pin-feed-col">
      <div class="pinterest-grid" id="pinterest-grid">

        <!-- Single Detail Card Panel: 2-Column Wide Preview -->
        <div class="pin-detail-card-wrapper" id="pin-detail-card-wrapper">
          <div class="detail-card-panel" id="detail-card-panel">

            <!-- Top Header Action Bar -->
            <div class="detail-top-bar">
              <!-- Left Side: Back button + Account Profile (No container background) -->
              <div class="top-bar-left">
                <button type="button" class="top-bar-icon-btn" id="detail-back-btn" title="Close Panel">
                  <i class="fa-solid fa-arrow-left"></i>
                </button>
                <div class="top-bar-account-profile">
                  <img class="top-bar-artist-img" src="assets/SenpaiWorks logo bg.png"
                    alt="SenpaiWorks Official Artist Logo" />
                  <div class="top-bar-artist-info">
                    <span class="top-bar-artist-name">SenpaiWorks</span>
                    <span class="top-bar-artist-label">Official Artist</span>
                  </div>
                </div>
              </div>

              <!-- Right Side: Action Icons (Like, Comment, Download, Share) -->
              <div class="top-bar-right">
                <button type="button" class="top-bar-icon-btn" id="detail-like-btn" title="Like Artwork">
                  <i class="fa-regular fa-heart" id="detail-like-icon"></i>
                  <span id="detail-like-count" class="top-bar-count">0</span>
                </button>
                <button type="button" class="top-bar-icon-btn" id="detail-comment-shortcut-btn" title="Toggle Comments">
                  <i class="fa-regular fa-comment"></i>
                  <span id="detail-comments-shortcut-count" class="top-bar-count">0</span>
                </button>
                <a id="detail-download-btn" class="top-bar-icon-btn" href="#" download="senpaiworks-artwork.jpg"
                  target="_blank" title="Download Artwork">
                  <i class="fa-solid fa-download"></i>
                </a>
                <button type="button" class="top-bar-icon-btn" id="detail-share-btn" title="Share Artwork">
                  <i class="fa-solid fa-arrow-up-from-bracket"></i>
                </button>
              </div>
            </div>

            <!-- Detail Card Body -->
            <div class="detail-card-body">

              <!-- Left: Image Container with Enlarge Button -->
              <div class="detail-image-container">
                <div class="detail-image-wrapper">
                  <img id="detail-main-img" src="" alt="Artwork Preview" />

                  <!-- Translucent Enlarge Fullscreen Button -->
                  <button type="button" class="enlarge-img-btn" id="enlarge-img-btn" title="Enlarge Artwork">
                    <i class="fa-solid fa-up-right-and-down-left-from-center"></i>
                  </button>
                </div>
              </div>

              <!-- Right: Information & Collapsible Comments Panel -->
              <div class="detail-info-panel" id="detail-info-panel">
                <h2 class="detail-title-text" id="detail-charname">Character Name</h2>

                <p class="detail-description-text" id="detail-description">Artwork description details will appear here
                  dynamically.</p>

                <div class="detail-metadata-section">
                  <h3 class="metadata-title">Specifications</h3>
                  <div class="metadata-badges-container" id="detail-badges-container"></div>
                </div>

                <!-- Collapsible Comments Section (Hidden by default, shown when comment button is clicked) -->
                <div class="detail-interactions-section" id="detail-comments-container" style="display: none;">
                  <div class="comment-header-row">
                    <span class="comment-header-title">Comments</span>
                    <span id="detail-comments-count-label" class="comment-count-badge">0</span>
                  </div>

                  <form id="detail-comment-form" class="comment-form">
                    <input type="text" id="detail-comment-text" placeholder="Add a comment to start the conversation..."
                      required />
                    <div class="comment-form-actions" style="position: relative;">
                      <button type="button" class="comment-emoji-btn" id="comment-emoji-btn" title="Add Emoji">
                        <i class="fa-regular fa-face-smile"></i>
                      </button>
                      <button type="submit" class="comment-submit-btn">
                        <i class="fa-solid fa-arrow-up"></i>
                      </button>

                      <!-- Emoji Picker Popover Box -->
                      <div class="emoji-picker-box" id="emoji-picker-box" style="display: none;">
                        <div class="emoji-grid">
                          <span class="emoji-item">😊</span>
                          <span class="emoji-item">❤️</span>
                          <span class="emoji-item">🔥</span>
                          <span class="emoji-item">👏</span>
                          <span class="emoji-item">😍</span>
                          <span class="emoji-item">😂</span>
                          <span class="emoji-item">✨</span>
                          <span class="emoji-item">🎉</span>
                          <span class="emoji-item">🚀</span>
                          <span class="emoji-item">💯</span>
                          <span class="emoji-item">👍</span>
                          <span class="emoji-item">🎨</span>
                          <span class="emoji-item">🌟</span>
                          <span class="emoji-item">🙌</span>
                          <span class="emoji-item">💡</span>
                          <span class="emoji-item">🤩</span>
                        </div>
                      </div>
                    </div>
                  </form>

                  <div id="detail-comments-list" class="comments-list"></div>

                  <button type="button" id="load-more-comments-btn" class="load-more-comments-btn"
                    style="display: none;">
                    <span>Load More Comments</span>
                    <i class="fa-solid fa-chevron-down"></i>
                  </button>
                </div>

              </div><!-- /.detail-info-panel -->

            </div><!-- /.detail-card-body -->

          </div><!-- /.detail-card-panel -->
        </div><!-- /.pin-detail-card-wrapper -->

        <!-- DIGITAL PORTRAITS -->
        <div class="pinterest-item" data-category="digital-portrait" data-charname="Kaori Miyazono"
          data-source="Your Lie in April" data-sex="Female" data-artstyle="Digital Art"
          data-description="Kaori Miyazono is a free-spirited violinist whose vibrant music reignites Kousei's passion for piano. Behind her radiant smile she hides a heartbreaking truth that shapes the soul of Your Lie in April.">
          <img
            src="https://res.cloudinary.com/dmzchsqms/image/upload/f_auto,q_auto/w_600/v1757630821/black_kaori_copy_csr9qi.webp"
            alt="Kaori" />
          <div class="pinterest-info">
            <p class="pinterest-title">Kaori</p>
            <p class="pinterest-category">Digital Portrait</p>
          </div>
        </div>

        <div class="pinterest-item" data-category="digital-portrait" data-charname="Miku Nakano"
          data-source="The Quintessential Quintuplets" data-sex="Female" data-artstyle="Digital Art"
          data-description="Miku Nakano is the quiet and history-loving third sister of the Nakano quintuplets. Her sincerity and depth of emotion make her unforgettable.">
          <img
            src="https://res.cloudinary.com/dmzchsqms/image/upload/f_auto,q_auto/w_600/v1757630824/miku_full_copy_vdritm.webp"
            alt="Miku" />
          <div class="pinterest-info">
            <p class="pinterest-title">Miku Nakano</p>
            <p class="pinterest-category">Digital Portrait</p>
          </div>
        </div>

        <div class="pinterest-item" data-category="digital-portrait" data-charname="Mikasa Ackerman"
          data-source="Attack on Titan" data-sex="Female" data-artstyle="Digital Art"
