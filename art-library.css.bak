:root {
  --accent-color: rgba(0, 102, 204, 0.9);
  --bg-color: #ffffff;
  --text-color: #1a1a1a;
  --subtext-color: #55555a;
}

body {
  background-color: var(--bg-color);
  background-image: none;
  color: var(--text-color);
  font-family: 'Plus Jakarta Sans', sans-serif;
  margin: 0;
  padding: 0;
  text-align: center;
  min-height: 100vh;
  padding-top: 76px;
}

@media (max-width: 768px) {
  body {
    padding-top: 46px;
  }
}

html {
  scroll-padding-top: clamp(46px, 8vw, 92px);
  scroll-behavior: smooth;
}

/* Hero Section */
.tech-hero-section {
  position: relative;
  height: 45vh;
  min-height: 320px;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: left;
}

.tech-hero-bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
  filter: brightness(0.4);
  background-size: cover;
  background-position: center;
}

.tech-hero-overlay {
  position: relative;
  z-index: 2;
  width: 100%;
  max-width: 1300px;
  padding: 0 40px;
  color: #fff;
  box-sizing: border-box;
}

.tech-title {
  font-size: clamp(1.6rem, 5vw, 3rem);
  text-transform: uppercase;
  margin-bottom: 20px;
  text-align: left;
}

.tech-description {
  font-size: clamp(0.9rem, 2.5vw, 1.2rem);
  line-height: 1.5;
  margin-bottom: 30px;
  color: #dcdcdc;
}

/* Category Filter Bar */
.category-filter-bar {
  display: flex;
  justify-content: center;
  gap: 12px;
  margin: 30px auto 16px auto;
  padding: 10px 24px;
  width: 100%;
  max-width: 100%;
  overflow-x: auto;
  scrollbar-width: none;
  -ms-overflow-style: none;
  box-sizing: border-box;
}

.category-filter-bar::-webkit-scrollbar {
  display: none;
}

.filter-btn {
  background: #f4f4f4;
  color: #1a1a1a;
  border: none;
  padding: 12px 24px;
  font-size: 0.95rem;
  font-weight: 700;
  border-radius: 30px;
  cursor: pointer;
  transition: all 0.3s cubic-bezier(0.25, 1, 0.5, 1);
  white-space: nowrap;

}

.filter-btn:hover {
  background: #e2e2e2;
  transform: translateY(-2px);

}

.filter-btn.active {
  background: #1a1a1a;
  color: #ffffff;

}

/* Pinterest Full-Canvas Edge-to-Edge Page Layout */
.pin-page-layout {
  position: relative;
  width: 100%;
  max-width: 100%;
  margin: 0;
  padding: 16px 24px 20px;
  box-sizing: border-box;
  display: flex;
  gap: 24px;
  align-items: flex-start;
  transition: all 0.3s cubic-bezier(0.25, 1, 0.5, 1);
}

/* Single Detail Card Panel: 2-Column Wide Positioned Card */
.pin-detail-card-wrapper {
  position: absolute;
  left: 0;
  top: 0;
  z-index: 100;
  box-sizing: border-box;
  display: none;
  opacity: 0;
  transition: opacity 0.3s cubic-bezier(0.25, 1, 0.5, 1);
}

.pin-page-layout.detail-open .pin-detail-card-wrapper {
  display: block;
  opacity: 1;
  pointer-events: auto;
}

@keyframes cardRefresh {
  0% {
    opacity: 0.6;
    transform: scale(0.985);
  }

  100% {
    opacity: 1;
    transform: scale(1);
  }
}

.detail-card-panel.refreshing {
  animation: cardRefresh 0.32s ease-out;
}

.detail-card-panel {
  width: 100%;
  background: #ffffff;
  border-radius: 28px;
  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.08);
  border: 1px solid #e2e8f0;
  overflow: hidden;
  position: relative;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

/* Top Header Action Bar */
.detail-top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 16px;
  border-bottom: 1px solid #f1f5f9;
  background: #ffffff;
  position: sticky;
  top: 0;
  z-index: 10;
  gap: 12px;
  box-sizing: border-box;
  width: 100%;
  border-top-left-radius: 27px;
  border-top-right-radius: 27px;
}

.top-bar-left {
  display: flex;
  align-items: center;
  gap: 8px;
  min-width: 0;
  flex: 1 1 auto;
  overflow: hidden;
}

.top-bar-icon-btn {
  background: transparent;
  border: none;
  height: 36px;
  min-width: 36px;
  padding: 0 8px;
  border-radius: 18px;
  color: #0f172a;
  font-size: 1.1rem;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.2s ease;
  gap: 4px;
  flex-shrink: 0;
}

.top-bar-icon-btn:focus {
  outline: none;
}

.top-bar-icon-btn:focus-visible {
  outline: 2px solid #0284c7;
  outline-offset: 1px;
}

.top-bar-icon-btn:hover {
  background: #f1f5f9;
  transform: translateY(-1px);
}

.top-bar-count {
  font-size: 0.82rem;
  font-weight: 700;
}

.top-bar-right {
  display: flex;
  align-items: center;
  gap: 6px;
  flex-shrink: 0;
}

.top-bar-account-profile {
  display: flex;
  align-items: center;
  gap: 8px;
  background: transparent;
  padding: 0;
  border-radius: 0;
  border: none;
  min-width: 0;
  flex: 1 1 auto;
  overflow: hidden;
}

.top-bar-artist-img {
  width: 36px;
  height: 36px;
  min-width: 36px;
  border-radius: 50%;
  object-fit: cover;
  background: transparent;
  border: none;
  flex-shrink: 0;
}

.top-bar-artist-info {
  display: flex;
  flex-direction: column;
  text-align: left;
  min-width: 0;
  overflow: hidden;
}

.top-bar-artist-name {
  font-size: 0.85rem;
  font-weight: 800;
  color: #0f172a;
  line-height: 1.15;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.top-bar-artist-label {
  font-size: 0.7rem;
  color: #64748b;
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.load-more-comments-btn {
  background: #f1f5f9;
  color: #0f172a;
  border: 1px solid #cbd5e1;
  padding: 8px 18px;
  font-size: 0.82rem;
  font-weight: 700;
  border-radius: 20px;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  margin-top: 10px;
  transition: all 0.2s ease;
  font-family: inherit;
}

.load-more-comments-btn:hover {
  background: #e2e8f0;
  color: #0066cc;
}

/* Detail Card Body */
.detail-card-body {
  display: flex;
  flex-direction: column;
  width: 100%;
}

/* Top half: Selected Artwork Image Preview (Pure White Background) */
.detail-image-container {
  flex: none;
  background: #ffffff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 24px 34px;
  border-bottom: 1px solid #f1f5f9;
  border-right: none;
  min-height: auto;
  box-sizing: border-box;
  position: relative;
  width: 100%;
}

.detail-image-wrapper {
  position: relative;
  display: inline-block;
  max-width: 100%;
}

.detail-image-wrapper img {
  max-width: 100%;
  max-height: 72vh !important;
  object-fit: contain;
  border-radius: 20px;
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.10);
  display: block;
  transition: opacity 0.2s ease, transform 0.2s ease;
}

.detail-image-wrapper img.changing {
  opacity: 0;
  transform: scale(0.97);
}

/* Translucent Enlarge Button */
.enlarge-img-btn {
  position: absolute;
  bottom: 16px;
  right: 16px;
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background: rgba(15, 23, 42, 0.55);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border: 1px solid rgba(255, 255, 255, 0.25);
  color: #ffffff;
  font-size: 1.05rem;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.25);
  transition: all 0.22s cubic-bezier(0.25, 1, 0.5, 1);
  z-index: 5;
}

.enlarge-img-btn:hover {
  background: rgba(15, 23, 42, 0.85);
  transform: scale(1.1);
  border-color: rgba(255, 255, 255, 0.45);
  box-shadow: 0 6px 20px rgba(0, 0, 0, 0.4);
  color: #ffffff;
}

/* Right half: Information details */
.detail-info-panel {
  flex: 0.8;
  padding: 36px 30px;
  display: flex;
  flex-direction: column;
  text-align: left;
  overflow-y: auto;
  max-height: 75vh;
  box-sizing: border-box;
  scrollbar-width: thin;
  scrollbar-color: #e0e0e0 transparent;
}

/* Creator / Artist Profile Row */
.detail-creator-row {
  display: flex;
  align-items: center;
  gap: 14px;
  margin-bottom: 20px;
}

.creator-img {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  object-fit: contain;
  background: #ffffff;
  border: 1px solid rgba(0, 0, 0, 0.08);
  /* Clean neutral border - NO red border! */
  padding: 2px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
}

.creator-name-col {
  display: flex;
  flex-direction: column;
  text-align: left;
}

.creator-name {
  font-size: 0.95rem;
  font-weight: 800;
  color: #0f172a;
}

.creator-label {
  font-size: 0.78rem;
  color: #64748b;
  font-weight: 600;
}

/* Title & Category Style Normal Text Row */
.detail-title-wrapper {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 4px;
  margin-bottom: 8px;
}

.detail-title-text {
  font-size: 1.5rem;
  font-weight: 800;
  color: #0f172a;
  margin: 0;
}

.detail-category-badge {
  display: inline-block;
  padding: 0;
  border-radius: 0;
  background: transparent;
  color: #64748b;
  border: none;
  font-size: 0.9rem;
  font-weight: 600;
  letter-spacing: normal;
  text-transform: capitalize;
  font-style: normal;
}

/* Mobile Action Bar Below Image (Instagram-exact layout) */
.mobile-action-bar {
  display: none;
}

@media (max-width: 768px) {
  .top-bar-right {
    display: none !important;
  }

  .mobile-action-bar {
    display: flex !important;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    max-width: 100%;
    padding: 12px 6px 4px 6px;
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
    box-sizing: border-box;
    margin-top: 6px;
  }

  .ig-action-left {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .ig-action-right {
    display: flex;
    align-items: center;
  }

  .ig-icon-btn {
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
    padding: 0 !important;
    margin: 0 !important;
    display: flex;
    align-items: center;
    gap: 6px;
    color: #0f172a;
    cursor: pointer;
    font-size: 1.35rem;
    line-height: 1;
    text-decoration: none;
  }

  .ig-icon-btn i {
    font-size: 1.35rem;
  }

  .ig-count {
    font-size: 0.92rem;
    font-weight: 700;
    color: #0f172a;
    font-family: 'Plus Jakarta Sans', -apple-system, sans-serif;
  }

  .detail-title-wrapper {
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
  }

  .detail-category-badge {
    font-size: 0.85rem;
    color: #64748b;
  }
}

/* Description & Specifications Spacing */
.detail-description-text {
  font-size: 0.95rem;
  line-height: 1.6;
  color: #334155;
  margin: 12px 0 24px 0;
}

.detail-metadata-section {
  margin-bottom: 28px;
  padding-top: 20px;
  border-top: 1px solid #f1f5f9;
}

.metadata-title {
  font-size: 0.92rem;
  font-weight: 800;
  color: #0f172a;
  margin: 0 0 14px 0;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.metadata-badges-container {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.metadata-badge {
  background: #f0f7ff;
  border: 1px solid rgba(0, 102, 204, 0.2);
  color: rgba(0, 102, 204, 0.9);
  padding: 6px 14px;
  border-radius: 20px;
  font-size: 0.8rem;
  font-weight: 700;
}

.metadata-badge span {
  color: #0f172a;
  font-weight: 800;
}

/* Detail Card Body & Unscaled Pinterest-Exact Comments Column Drawer */
.detail-card-body {
  display: flex;
  flex-direction: row;
  flex-wrap: nowrap;
  width: 100%;
  box-sizing: border-box;
}

.detail-main-col {
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  width: 100%;
  flex: 1 1 100%;
}

.detail-card-body:not(.comments-open) .detail-main-col {
  margin: 0 auto !important;
}

.detail-card-body:not(.comments-open) .detail-image-container {
  width: 100% !important;
  display: flex !important;
  justify-content: center !important;
  align-items: center !important;
  text-align: center !important;
}

.detail-card-body:not(.comments-open) .detail-image-wrapper {
  margin: 0 auto !important;
  display: inline-block !important;
}

.detail-card-body:not(.comments-open) .detail-image-wrapper img {
  margin: 0 auto !important;
  display: block !important;
  max-height: 52vh !important;
}

.detail-card-body:not(.comments-open) .detail-info-section {
  width: 100% !important;
  max-width: 680px !important;
  margin: 0 auto !important;
  box-sizing: border-box !important;
}

.detail-info-section {
  padding: 18px 24px;
  text-align: left;
}

/* Dedicated Comments Right Column Drawer (Hidden by default) */
#detail-comments-container.detail-comments-col {
  display: none !important;
  box-sizing: border-box;
}

/* Laptop Screens (Standard Desktop & Laptops: 52vh max-height so image + title + description fit without scrolling) */
@media (min-width: 820px) {
  .detail-card-panel {
    display: flex;
    flex-direction: column;
    max-height: none;
    overflow: hidden;
  }

  .detail-card-body.comments-open {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    justify-content: flex-start;
    align-items: stretch;
    gap: 0;
    overflow: hidden;
  }

  .detail-card-body.comments-open .detail-main-col {
    box-sizing: border-box;
    height: auto;
    max-height: none;
    overflow: visible;
  }

  .detail-card-body.comments-open .detail-image-wrapper img {
    max-height: 52vh;
    /* Matches closed state (52vh) pixel-for-pixel */
    width: auto;
    object-fit: contain;
  }

  .detail-card-body.comments-open #detail-comments-container.detail-comments-col {
    display: flex !important;
    flex-direction: column !important;
    justify-content: flex-start !important;
    border-left: 1px solid #f1f5f9 !important;
    padding: 20px 18px !important;
    background: #ffffff !important;
    box-sizing: border-box !important;
    align-self: stretch !important;
    overflow: hidden !important;
  }

  .comment-header-row {
    flex-shrink: 0 !important;
    margin-bottom: 14px !important;
  }

  .detail-card-body.comments-open #detail-comments-list {
    flex: 1 1 auto !important;
    min-height: 0 !important;
    overflow-y: auto !important;
    padding-right: 4px !important;
    margin-bottom: 14px !important;
    width: 100% !important;
    box-sizing: border-box !important;
  }

  .detail-card-body.comments-open .comment-form {
    flex-shrink: 0 !important;
    margin-top: auto !important;
    margin-bottom: 0 !important;
    position: relative !important;
    background: #f8fafc !important;
    z-index: 10 !important;
  }
}

/* Extra Large Desktop Monitors (>1440px width and >900px height) */
@media (min-width: 1441px) and (min-height: 901px) {
  .detail-card-body:not(.comments-open) .detail-image-wrapper img {
    max-height: 72vh !important;
  }

  .detail-card-body.comments-open .detail-image-wrapper img {
    max-height: 72vh !important;
  }
}

@media (max-width: 819px) {
  .detail-card-body.comments-open {
    flex-direction: column !important;
  }

  .detail-card-body.comments-open .detail-main-col {
    width: 100% !important;
    flex: none !important;
  }

  .detail-card-body.comments-open .detail-image-wrapper img {
    max-height: 46vh !important;
  }

  .detail-card-body.comments-open #detail-comments-container.detail-comments-col {
    display: flex !important;
    flex-direction: column !important;
    border-top: 1px solid #f1f5f9 !important;
    padding: 20px 16px !important;
    margin-top: 16px !important;
    background: #ffffff;
    width: 100% !important;
    min-height: 400px !important;
    box-sizing: border-box !important;
  }

  .detail-card-body.comments-open #detail-comments-list {
    flex: 1 1 auto !important;
    overflow-y: auto !important;
    max-height: 360px !important;
  }
}

.comment-header-row {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 16px;
}

.comment-header-title {
  font-size: 1.1rem;
  font-weight: 800;
  color: #111111;
}

.comment-count-badge {
  background: #f1f5f9;
  color: #475569;
  font-weight: 700;
  font-size: 0.85rem;
  padding: 2px 10px;
  border-radius: 12px;
}

.comment-form {
  display: flex !important;
  flex-direction: row !important;
  flex-wrap: nowrap !important;
  align-items: center !important;
  justify-content: space-between !important;
  gap: 10px !important;
  margin-top: auto !important;
  margin-bottom: 0 !important;
  background: #f8fafc !important;
  padding: 4px 6px 4px 12px !important;
  border-radius: 28px !important;
  border: 1.5px solid #e2e8f0 !important;
  width: 100% !important;
  height: 48px !important;
  max-height: 48px !important;
  min-height: 48px !important;
  box-sizing: border-box !important;
  position: relative !important;
  flex-shrink: 0 !important;
  align-self: auto !important;
}

.comment-form input {
  flex: 1 1 auto !important;
  min-width: 0 !important;
  width: 0 !important;
  height: 100% !important;
  border: none !important;
  background: transparent !important;
  color: #0f172a !important;
  font-family: inherit;
  font-size: 0.88rem !important;
  outline: none !important;
  padding: 0 !important;
  margin: 0 !important;
}

.comment-emoji-btn {
  background: transparent !important;
  border: none !important;
  color: #64748b !important;
  font-size: 1.2rem !important;
  cursor: pointer;
  padding: 0 !important;
  width: 32px !important;
  height: 32px !important;
  border-radius: 50%;
  display: flex !important;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
  flex-shrink: 0 !important;
}

.comment-emoji-btn:hover {
  color: #0284c7 !important;
  background: #e0f2fe !important;
}

/* Emoji Picker Popover Box */
.emoji-picker-box {
  position: absolute;
  bottom: 54px;
  left: 12px;
  background: #ffffff;
  border: 1px solid #e2e8f0;
  border-radius: 18px;
  padding: 12px;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
  z-index: 100;
  width: 220px;
  box-sizing: border-box;
}

.emoji-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 6px;
  text-align: center;
}

.emoji-item {
  font-size: 1.35rem;
  cursor: pointer;
  padding: 6px;
  border-radius: 10px;
  user-select: none;
  transition: background 0.15s ease, transform 0.15s ease;
}

.emoji-item:hover {
  background: #f1f5f9;
  transform: scale(1.2);
}

.comment-submit-btn {
  background: #0284c7 !important;
  color: #ffffff !important;
  border: none !important;
  border-radius: 50% !important;
  width: 34px !important;
  height: 34px !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  cursor: pointer;
  flex-shrink: 0 !important;
  margin-left: auto !important;
  font-size: 0.85rem !important;
  box-shadow: 0 3px 8px rgba(2, 132, 199, 0.25) !important;
  transition: transform 0.15s ease, background 0.15s ease !important;
}

.comment-submit-btn:hover {
  background: #0369a1 !important;
  transform: scale(1.06) !important;
}

.comments-list {
  flex: 1 1 0%;
  min-height: 0;
  max-height: none;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-bottom: 14px;
  scrollbar-width: thin;
  scrollbar-color: #cbd5e1 transparent;
}

.detail-comment-item-box {
  display: flex;
  gap: 10px;
  border-bottom: 1px solid #f4f4f4;
  padding-bottom: 8px;
}

.detail-comment-avatar {
  flex-shrink: 0;
  width: 30px;
  height: 30px;
  border-radius: 50%;
  background: #efefef;
  color: #555;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: 0.75rem;
  text-transform: uppercase;
}

.detail-comment-body {
  flex-grow: 1;
}

.detail-comment-username {
  font-weight: 700;
  color: #111;
  font-size: 0.82rem;
}

.detail-comment-date {
  font-size: 0.7rem;
  color: #aaa;
}

.detail-comment-text {
  font-size: 0.85rem;
  line-height: 1.4;
  color: #444;
  margin: 3px 0 0 0;
  white-space: pre-wrap;
}

/* Enlarged Fullscreen Lightbox Modal */
.image-lightbox-modal {
  position: fixed;
  inset: 0;
  z-index: 999999;
  background: rgba(0, 0, 0, 0.92);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
  padding: 40px;
  user-select: none;
  box-sizing: border-box;
}

.image-lightbox-modal.active {
  opacity: 1;
  pointer-events: auto;
}

.lightbox-close-btn {
  position: absolute;
  top: 28px;
  left: 28px;
  width: 48px;
  height: 48px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.15);
  border: 1px solid rgba(255, 255, 255, 0.2);
  color: #ffffff;
  font-size: 1.4rem;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: background 0.2s ease, transform 0.2s ease;
  z-index: 1000000;
}

.lightbox-close-btn:hover {
  background: rgba(255, 255, 255, 0.3);
  transform: scale(1.08);
}

/* Floating Zoom Control Bar */
.lightbox-zoom-controls {
  position: absolute;
  bottom: 32px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 1000000;
  display: flex;
  align-items: center;
  gap: 10px;
  background: rgba(15, 23, 42, 0.75);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border: 1px solid rgba(255, 255, 255, 0.18);
  padding: 6px 18px;
  border-radius: 40px;
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.45);
}

.zoom-btn {
  background: rgba(255, 255, 255, 0.12);
  border: none;
  width: 36px;
  height: 36px;
  border-radius: 50%;
  color: #ffffff;
  font-size: 0.9rem;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: background 0.2s ease, transform 0.2s ease;
}

.zoom-btn:hover {
  background: rgba(255, 255, 255, 0.28);
  transform: scale(1.08);
}

.zoom-level-text {
  color: #ffffff;
  font-size: 0.85rem;
  font-weight: 700;
  min-width: 48px;
  text-align: center;
  letter-spacing: 0.5px;
  font-family: monospace, sans-serif;
}

.lightbox-content {
  max-width: 92vw;
  max-height: 92vh;
  display: flex;
  align-items: center;
  justify-content: center;
}

.lightbox-content img {
  max-width: 92vw;
  max-height: 92vh;
  object-fit: contain;
  border-radius: 18px;
  box-shadow: 0 25px 60px rgba(0, 0, 0, 0.6);
  user-select: none;
  -webkit-user-drag: none;
  cursor: grab;
  will-change: transform;
}

/* Masonry Feed */
.pin-feed-col {
  position: relative;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.pinterest-grid {
  position: relative;
  width: 100%;
  margin: 0;
}


.pinterest-item {
  position: absolute;
  background: #fff;
  border-radius: 18px;
  overflow: hidden;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.07);
  transition: transform 0.22s cubic-bezier(0.25, 1, 0.5, 1), box-shadow 0.22s ease, top 0.4s ease, left 0.4s ease, width 0.4s ease;
  cursor: pointer;
  display: flex;
  flex-direction: column;
  border: 2px solid transparent;
  box-sizing: border-box;
}

/* Natural image height (true masonry - NO height: 200px crop!) */
.pinterest-item img {
  width: 100%;
  height: auto;
  display: block;
  transition: transform 0.22s cubic-bezier(0.25, 1, 0.5, 1), filter 0.22s ease;
}

.pinterest-item:hover {
  transform: scale(1.02);
  box-shadow: 0 14px 32px rgba(0, 0, 0, 0.14);
}

.pinterest-item:hover img {
  filter: brightness(1.05);
}

.pinterest-info {
  padding: 12px 16px;
  text-align: left;
  background: #fff;
}

.pinterest-title {
  margin: 0 0 4px 0;
  font-size: 0.95rem;
  font-weight: 800;
  color: #1a1a1a;
}

.pinterest-category {
  margin: 0;
  font-size: 0.78rem;
  font-weight: 600;
  color: #88888a;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

/* Responsive Mobile & Tablet Styles */
@media (max-width: 768px) {
  .pin-page-layout {
    padding: 16px 12px;
    display: block !important;
  }

  .tech-hero-section {
    height: 40vh;
    min-height: 280px;
  }

  .tech-hero-overlay {
    padding: 0 20px;
  }

  .tech-title {
    font-size: 1.8rem;
    margin-bottom: 12px;
  }

  .tech-description {
    font-size: 0.95rem;
    margin-bottom: 20px;
  }

  .category-filter-bar {
    justify-content: flex-start;
    padding: 8px 12px;
    gap: 8px;
    margin: 16px auto 8px auto;
  }

  .filter-btn {
    padding: 8px 16px;
    font-size: 0.85rem;
  }

  /* Mobile Preview Card: At the VERY TOP of the screen */
  .pin-detail-card-wrapper {
    position: relative !important;
    width: 100% !important;
    left: auto !important;
    top: auto !important;
    margin-bottom: 24px !important;
    z-index: 10;
    flex: none !important;
  }

  .detail-card-panel {
    max-height: none !important;
    border-radius: 20px;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.08);
  }

  .detail-top-bar {
    padding: 10px 12px;
    gap: 8px;
  }

  .top-bar-left {
    gap: 6px;
  }

  .top-bar-artist-img {
    width: 32px;
    height: 32px;
    min-width: 32px;
  }

  .top-bar-artist-name {
    font-size: 0.82rem;
  }

  .top-bar-artist-label {
    font-size: 0.65rem;
  }

  .top-bar-right {
    gap: 4px;
  }

  .top-bar-icon-btn {
    height: 32px;
    min-width: 32px;
    padding: 0 4px;
    font-size: 0.95rem;
  }

  .top-bar-count {
    font-size: 0.78rem;
  }

  .download-btn {
    padding: 8px 16px;
    font-size: 0.82rem;
    border-radius: 20px;
  }

  .detail-card-body {
    flex-direction: column;
  }

  .detail-image-container {
    padding: 16px;
  }

  .detail-image-wrapper img {
    max-height: 46vh;
    border-radius: 16px;
  }

  .detail-info-panel {
    padding: 20px 16px;
  }

  /* 2-Column Responsive Grid on Mobile BELOW the Top Preview Card */
  .pinterest-grid {
    position: relative;
    width: 100%;
    margin: 0;
  }

  .pinterest-grid .pinterest-item {
    border-radius: 14px;
    box-sizing: border-box;
  }

  .pinterest-info {
    padding: 10px 12px;
  }

  .pinterest-title {
    font-size: 0.88rem;
  }

  .pinterest-category {
    font-size: 0.72rem;
  }

  .lightbox-close-btn {
    top: 16px;
    left: 16px;
    width: 40px;
    height: 40px;
    font-size: 1.1rem;
  }

  .lightbox-zoom-controls {
    bottom: 20px;
    padding: 4px 14px;
    gap: 6px;
  }

  .zoom-btn {
    width: 32px;
    height: 32px;
    font-size: 0.8rem;
  }

  .zoom-level-text {
    font-size: 0.78rem;
    min-width: 40px;
  }
}

@media (max-width: 480px) {
  .detail-top-bar {
    padding: 8px 10px;
    gap: 4px;
  }

  .top-bar-artist-label {
    display: none;
    /* Hide subtitle label on tiny mobile screens to avoid text squeeze */
  }

  .top-bar-icon-btn {
    height: 30px;
    min-width: 30px;
    padding: 0 3px;
    font-size: 0.88rem;
  }

  .top-bar-right {
    gap: 2px;
  }

  .pinterest-grid .pinterest-item {
    width: calc(50% - 4px) !important;
  }

  .pinterest-grid {
    gap: 8px !important;
  }

  .pinterest-info {
    padding: 8px 10px;
  }

  .pinterest-title {
    font-size: 0.82rem;
  }

  .pinterest-category {
    font-size: 0.68rem;
  }
}

/* Page Refresh Overlay */
.page-refresh-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  background: rgba(10, 10, 10, 0.95);
  z-index: 9999;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s cubic-bezier(0.25, 1, 0.5, 1);
  display: flex;
  align-items: center;
  justify-content: center;
}

.page-refresh-overlay.active {
  opacity: 1;
  pointer-events: all;
}

.page-refresh-overlay::after {
  content: "";
  width: 48px;
  height: 48px;
  border: 4px solid rgba(255, 255, 255, 0.1);
  border-left-color: var(--accent-color);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

/* ── Instagram-Style Comment Layout ── */
.detail-comment-item-box {
  display: flex !important;
  align-items: flex-start !important;
  gap: 12px !important;
  padding: 10px 0 !important;
  width: 100% !important;
  box-sizing: border-box !important;
}

.detail-comment-avatar,
.detail-comment-avatar-img {
  width: 34px;
  height: 34px;
  border-radius: 50%;
  background: #000000;
  color: #ffffff;
  font-weight: 700;
  font-size: 0.85rem;
  display: flex;
  align-items: center;
  justify-content: center;
  object-fit: cover;
  flex-shrink: 0;
}

.detail-comment-body {
  text-align: left !important;
  display: flex !important;
  flex-direction: column !important;
  align-items: flex-start !important;
  flex: 1 1 0% !important;
  width: 100% !important;
  min-width: 0 !important;
  box-sizing: border-box !important;
}

.comment-top-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12px;
  width: 100%;
}

.comment-top-right-actions {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-shrink: 0;
}

.comment-text-row {
  text-align: left !important;
  margin-top: 4px;
  margin-bottom: 6px;
  word-break: break-word;
  width: 100%;
}

.detail-comment-username {
  font-weight: 700;
  color: #0f172a;
  font-size: 0.88rem;
}

.detail-comment-text {
  text-align: left !important;
  display: block !important;
  font-size: 0.88rem;
  line-height: 1.45;
  color: #1e293b;
  margin: 0;
}

.comment-mention-tag {
  color: #0284c7 !important;
  font-weight: 600 !important;
  cursor: pointer;
}

.comment-mention-tag:hover {
  text-decoration: underline;
}

.comment-top-row .comment-like-btn {
  background: none;
  border: none;
  padding: 2px 4px;
  cursor: pointer;
  color: #94a3b8;
  font-size: 0.95rem;
  transition: transform 0.15s ease, color 0.15s ease;
  flex-shrink: 0;
}

.comment-top-row .comment-like-btn:hover {
  transform: scale(1.15);
  color: #64748b;
}

.comment-top-row .comment-like-btn.liked {
  color: #ef4444;
}

.comment-top-row .comment-like-btn.liked i {
  color: #ef4444;
}

.comment-sub-row {
  display: flex;
  align-items: center;
  gap: 14px;
  margin-top: 4px;
  font-size: 0.76rem;
  color: #64748b;
}

.comment-time-ago {
  color: #64748b;
  font-weight: 500;
}

.comment-likes-label {
  font-weight: 600;
  color: #64748b;
}

.comment-sub-row .comment-action-btn {
  background: none;
  border: none;
  color: #64748b;
  font-size: 0.76rem;
  font-weight: 700;
  cursor: pointer;
  padding: 0;
  transition: color 0.15s ease;
}

.comment-sub-row .comment-action-btn:hover {
  color: #0f172a;
}

/* Inline Reply Input Box */
.comment-reply-box {
  display: none;
  align-items: center;
  gap: 8px;
  margin-top: 8px;
  margin-bottom: 4px;
  background: #f8fafc;
  padding: 4px 6px 4px 14px;
  border-radius: 20px;
  border: 1px solid #cbd5e1;
  width: 100%;
  box-sizing: border-box;
}

.comment-reply-box.active {
  display: flex !important;
}

.comment-reply-input {
  flex: 1;
  min-width: 0;
  border: none;
  background: transparent;
  color: #0f172a;
  font-family: inherit;
  font-size: 0.82rem;
  outline: none;
  padding: 4px 0;
}

.comment-reply-submit-btn {
  background: #0284c7;
  color: #ffffff;
  border: none;
  padding: 5px 14px;
  border-radius: 16px;
  font-size: 0.76rem;
  font-weight: 700;
  cursor: pointer;
  white-space: nowrap;
  transition: background 0.15s ease;
}

.comment-reply-submit-btn:hover {
  background: #0369a1;
}

.comment-options-wrapper {
  position: relative;
  margin-left: auto;
}

.comment-options-btn {
  background: none;
  border: none;
  color: #94a3b8;
  font-size: 0.95rem;
  cursor: pointer;
  padding: 2px 6px;
  border-radius: 50%;
  transition: color 0.15s ease;
}

.comment-options-btn:hover {
  color: #1e293b;
  background: rgba(0, 0, 0, 0.05);
}

.comment-options-dropdown {
  display: none !important;
  position: absolute;
  right: 0;
  top: 100%;
  background: #ffffff !important;
  border: 1px solid #e2e8f0 !important;
  box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.15) !important;
  border-radius: 12px !important;
  padding: 6px 0 !important;
  z-index: 9999 !important;
  min-width: 130px;
  overflow: hidden;
}

.comment-options-dropdown.active {
  display: block !important;
}

.comment-dropdown-item {
  width: 100%;
  text-align: left;
  padding: 8px 14px;
  background: transparent !important;
  border: none !important;
  outline: none !important;
  font-size: 0.78rem;
  font-weight: 600;
  color: #334155 !important;
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: 8px;
  transition: background 0.15s ease;
  box-shadow: none !important;
  border-radius: 0 !important;
}

.comment-dropdown-item:hover {
  background: #f1f5f9 !important;
}

.comment-dropdown-item.danger {
  color: #dc2626 !important;
}

.comment-dropdown-item.danger:hover {
  background: #fef2f2 !important;
}

/* Instagram-style View Replies Line */
.comment-replies-toggle-btn {
  background: none;
  border: none;
  color: #64748b;
  font-size: 0.76rem;
  font-weight: 700;
  cursor: pointer;
  padding: 6px 0;
  display: inline-flex;
  align-items: center;
  gap: 12px;
  margin-top: 6px;
  transition: color 0.15s ease;
}

.comment-replies-toggle-btn:hover {
  color: #0f172a;
}

.view-replies-line {
  display: inline-block;
  width: 24px;
  height: 1px;
  background: #cbd5e1;
}

.view-replies-text {
  font-size: 0.76rem;
  font-weight: 700;
  color: #64748b;
}

.comment-replies-toggle-btn:hover .view-replies-line {
  background: #0f172a;
}

.comment-replies-toggle-btn:hover .view-replies-text {
  color: #0f172a;
}

.comment-replies-container {
  margin-left: 36px;
  margin-top: 4px;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.comment-replies-container.collapsed {
  display: none !important;
}

/* ── Auth Required Modal Card ── */
.auth-modal-overlay {
  display: none;
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  background: rgba(15, 23, 42, 0.65);
  backdrop-filter: blur(6px);
  z-index: 10000;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transition: opacity 0.25s ease;
}

.auth-modal-overlay.active {
  display: flex;
  opacity: 1;
}

.auth-modal-card {
  background: #ffffff;
  width: 90%;
  max-width: 400px;
  border-radius: 20px;
  padding: 28px 24px;
  text-align: center;
  box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
  transform: translateY(12px);
  transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  font-family: 'Plus Jakarta Sans', sans-serif;
}

.auth-modal-overlay.active .auth-modal-card {
  transform: translateY(0);
}

.auth-modal-icon {
  width: 56px;
  height: 56px;
  background: rgba(2, 132, 199, 0.1);
  color: #0284c7;
  border-radius: 50%;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 1.5rem;
  margin-bottom: 16px;
}

.auth-modal-title {
  margin: 0 0 8px 0;
  font-size: 1.25rem;
  font-weight: 800;
  color: #0f172a;
}

.auth-modal-text {
  margin: 0 0 24px 0;
  font-size: 0.88rem;
  color: #64748b;
  line-height: 1.5;
}

.auth-modal-actions {
  display: flex;
  gap: 12px;
}

.auth-modal-btn {
  flex: 1;
  padding: 10px 16px;
  border-radius: 12px;
  font-size: 0.88rem;
  font-weight: 700;
  cursor: pointer;
  border: none;
  transition: all 0.15s ease;
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.auth-modal-btn.cancel {
  background: #f1f5f9;
  color: #475569;
}

.auth-modal-btn.cancel:hover {
  background: #e2e8f0;
  color: #0f172a;
}

.auth-modal-btn.confirm {
  background: #0f172a;
  color: #ffffff;
  box-shadow: 0 4px 12px rgba(15, 23, 42, 0.2);
}

.auth-modal-btn.confirm:hover {
  background: #1e293b;
  transform: translateY(-1px);
}

/* ── 3-Dot Dropdown Menu Stylings ────────────────────────── */
.top-bar-dropdown-wrapper {
  position: relative;
  display: inline-block;
}

.art-dropdown-menu {
  position: absolute;
  top: calc(100% + 8px);
  right: 0;
  width: 210px;
  background: #ffffff;
  border-radius: 16px;
  box-shadow: 0 12px 32px rgba(0, 0, 0, 0.15), 0 2px 6px rgba(0, 0, 0, 0.05);
  border: 1px solid #e2e8f0;
  padding: 8px;
  z-index: 1000;
  display: flex;
  flex-direction: column;
  gap: 2px;
  opacity: 0;
  visibility: hidden;
  transform: translateY(-8px) scale(0.95);
  transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  pointer-events: none;
}

.art-dropdown-menu.active {
  opacity: 1;
  visibility: visible;
  transform: translateY(0) scale(1);
  pointer-events: auto;
}

.art-dropdown-item {
  display: flex;
  align-items: center;
  gap: 12px;
  width: 100%;
  padding: 10px 14px;
  border: none;
  background: transparent;
  color: #1e293b;
  font-family: inherit;
  font-size: 0.88rem;
  font-weight: 600;
  border-radius: 10px;
  cursor: pointer;
  text-align: left;
  transition: background 0.15s ease, color 0.15s ease;
  box-sizing: border-box;
}

.art-dropdown-item i {
  font-size: 1rem;
  width: 18px;
  text-align: center;
  color: #64748b;
  transition: color 0.15s ease;
}

.art-dropdown-item:hover {
  background: #f1f5f9;
  color: #0f172a;
}

.art-dropdown-item:hover i {
  color: #0066cc;
}

.art-dropdown-item.is-interested {
  color: #d97706;
}

.art-dropdown-item.is-interested i {
  color: #f59e0b;
}

.mobile-dropdown-menu {
  right: 0;
  left: auto;
  bottom: calc(100% + 8px);
  top: auto;
}

/* ── About This Art Modal ─────────────────────────────── */
.art-modal-overlay {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.65);
  backdrop-filter: blur(8px);
  z-index: 2000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}

.art-modal-overlay.active {
  opacity: 1;
  visibility: visible;
}

.art-modal-card {
  background: #ffffff;
  border-radius: 24px;
  width: 100%;
  max-width: 560px;
  max-height: 90vh;
  overflow-y: auto;
  box-shadow: 0 24px 48px rgba(0, 0, 0, 0.22);
  position: relative;
  padding: 28px;
  box-sizing: border-box;
  transform: scale(0.92);
  transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  text-align: left;
}

.art-modal-overlay.active .art-modal-card {
  transform: scale(1);
}

.art-modal-close {
  position: absolute;
  top: 20px;
  right: 20px;
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background: #f1f5f9;
  border: none;
  color: #475569;
  font-size: 1.1rem;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.15s ease;
}

.art-modal-close:hover {
  background: #e2e8f0;
  color: #0f172a;
}

.art-modal-header {
  margin-bottom: 20px;
  padding-right: 40px;
}

.art-modal-badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: #eff6ff;
  color: #2563eb;
  font-size: 0.78rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  padding: 4px 10px;
  border-radius: 20px;
  margin-bottom: 8px;
}

.art-modal-title {
  margin: 0;
  font-size: 1.5rem;
  font-weight: 800;
  color: #0f172a;
  line-height: 1.25;
}

.art-modal-body {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.art-modal-preview {
  width: 100%;
  max-height: 260px;
  border-radius: 16px;
  overflow: hidden;
  background: #f8fafc;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid #e2e8f0;
}

.art-modal-preview img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  max-height: 260px;
}

.art-modal-info-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14px 20px;
}

.info-row {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.info-row.full-width {
  grid-column: 1 / -1;
}

.info-label {
  font-size: 0.78rem;
  font-weight: 700;
  color: #64748b;
  text-transform: uppercase;
  letter-spacing: 0.4px;
  display: flex;
  align-items: center;
  gap: 6px;
}

.info-label i {
  color: #0066cc;
}

.info-val {
  font-size: 0.95rem;
  font-weight: 700;
  color: #1e293b;
}

.info-desc {
  margin: 0;
  font-size: 0.9rem;
  color: #475569;
  line-height: 1.5;
}

.license-box {
  background: #f8fafc;
  border: 1px dashed #cbd5e1;
  padding: 12px 16px;
  border-radius: 12px;
}

.info-license-text {
  margin: 4px 0 0 0;
  font-size: 0.82rem;
  color: #64748b;
  line-height: 1.45;
}

.art-modal-footer {
  margin-top: 20px;
  padding-top: 18px;
  border-top: 1px solid #f1f5f9;
  display: flex;
  gap: 12px;
}

.art-modal-btn {
  flex: 1;
  padding: 12px 18px;
  border-radius: 14px;
  font-size: 0.9rem;
  font-weight: 700;
  cursor: pointer;
  border: none;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  transition: all 0.2s ease;
}

.art-modal-btn.primary {
  background: #0f172a;
  color: #ffffff;
  box-shadow: 0 4px 14px rgba(15, 23, 42, 0.25);
}

.art-modal-btn.primary:hover {
  background: #1e293b;
  transform: translateY(-1px);
}

.art-modal-btn.secondary {
  background: #f1f5f9;
  color: #1e293b;
}

.art-modal-btn.secondary:hover {
  background: #e2e8f0;
}

.art-modal-btn.secondary.is-interested {
  background: #fef3c7;
  color: #b45309;
}

/* ── Art Toast Notification ─────────────────────────────── */
.art-toast-notification {
  position: fixed;
  bottom: 28px;
  left: 50%;
  transform: translateX(-50%) translateY(40px);
  background: #0f172a;
  color: #ffffff;
  padding: 12px 22px;
  border-radius: 30px;
  font-size: 0.88rem;
  font-weight: 700;
  display: flex;
  align-items: center;
  gap: 10px;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
  z-index: 3000;
  opacity: 0;
  pointer-events: none;
  transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}

.art-toast-notification.active {
  opacity: 1;
  transform: translateX(-50%) translateY(0);
}

.art-toast-notification i {
  color: #38bdf8;
  font-size: 1.05rem;
}

/* ── Comment 3-Dot Options Dropdown (High Z-Index Fix) ───── */
.comment-top-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  position: relative;
}

.comment-top-right-actions {
  display: flex;
  align-items: center;
  gap: 8px;
  position: relative;
}

.comment-options-wrapper {
  position: relative;
  display: inline-block;
}

.comment-options-btn {
  background: transparent;
  border: none;
  color: #64748b;
  font-size: 0.9rem;
  padding: 4px 6px;
  border-radius: 50%;
  cursor: pointer;
  transition: all 0.15s ease;
}

.comment-options-btn:hover {
  background: #f1f5f9;
  color: #0f172a;
}

.comment-options-dropdown {
  position: absolute;
  top: calc(100% + 4px);
  right: 0;
  width: 140px;
  background: #ffffff;
  border: 1px solid #e2e8f0;
  border-radius: 14px;
  box-shadow: 0 12px 30px rgba(0, 0, 0, 0.2), 0 2px 8px rgba(0, 0, 0, 0.08);
  padding: 6px;
  z-index: 99999 !important;
  /* High Z-index ensures dropdown appears ON TOP of commenting box */
  display: flex;
  flex-direction: column;
  gap: 2px;
  opacity: 0;
  visibility: hidden;
  transform: translateY(-6px) scale(0.95);
  transition: all 0.18s cubic-bezier(0.16, 1, 0.3, 1);
  pointer-events: none;
}

.comment-options-dropdown.active {
  opacity: 1 !important;
  visibility: visible !important;
  transform: translateY(0) scale(1) !important;
  pointer-events: auto !important;
}

.comment-dropdown-item {
  display: flex;
  align-items: center;
  gap: 8px;
  width: 100%;
  padding: 8px 10px;
  border: none;
  background: transparent;
  color: #1e293b;
  font-family: inherit;
  font-size: 0.82rem;
  font-weight: 600;
  border-radius: 8px;
  cursor: pointer;
  text-align: left;
  transition: background 0.15s ease, color 0.15s ease;
  box-sizing: border-box;
}

.comment-dropdown-item i {
  font-size: 0.88rem;
  width: 16px;
  text-align: center;
  color: #64748b;
}

.comment-dropdown-item:hover {
  background: #f1f5f9;
  color: #0f172a;
}

.comment-dropdown-item.danger {
  color: #ef4444;
}

.comment-dropdown-item.danger i {
  color: #ef4444;
}

.comment-dropdown-item.danger:hover {
  background: #fef2f2;
}