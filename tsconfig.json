{
  "compilerOptions": {
    "target": "es2020",
    "module": "es2020",
    "lib": ["dom", "dom.iterable", "es2020"],
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "noEmit": false,
    "rootDir": "./scripts",
    "outDir": "./scripts",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["scripts/**/*.ts"],
  "exclude": ["scripts/node_modules"]
}
